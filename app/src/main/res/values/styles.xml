<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MikoTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#AB94D8</item>
        <item name="android:colorControlActivated">#AB94D8</item>
        <item name="android:colorControlHighlight">#33AB94D8</item>
        <item name="android:colorBackground">#F8F6FC</item>
        <item name="android:windowBackground">#F8F6FC</item>
        <item name="android:textColorPrimary">#362E48</item>
        <item name="android:textColorSecondary">#7E7591</item>
        <item name="android:textColorHint">#9B93AA</item>
        <item name="android:editTextColor">#362E48</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/MikoAlertDialogTheme</item>
    </style>

    <style name="MikoAlertDialogTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#AB94D8</item>
        <item name="android:colorControlActivated">#AB94D8</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#362E48</item>
        <item name="android:textColorSecondary">#7E7591</item>
        <item name="android:textColorHint">#9B93AA</item>
        <item name="android:editTextColor">#362E48</item>
    </style>
</resources>
